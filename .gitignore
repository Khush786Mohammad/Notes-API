# ==========================================================
# Common .gitignore for note-api (Spring Boot backend + Angular frontend)
# Patterns are NOT anchored with a leading "/" so they match
# in any subfolder (e.g. backend/, frontend/).
# ==========================================================

# ---------- Backend: Maven / Spring Boot ----------
HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle / generic build output
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ---------- Frontend: Angular / Node ----------
# Compiled output
dist/
tmp/
out-tsc/
bazel-out/

# Node
node_modules/
npm-debug.log
yarn-error.log

# Angular caches and misc
**/.angular/cache
**/.sass-cache/
**/connect.lock
**/coverage/
**/libpeerconnection.log
**/testem.log
**/typings/
**/__screenshots__/

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example
*.log

# ---------- IDEs and editors ----------
# STS / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
.c9/
*.launch

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# Sublime
*.sublime-workspace

# Visual Studio Code (keep shared config files)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# ---------- System files ----------
.DS_Store
Thumbs.db